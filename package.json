{
  "name": "zacgym-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:studio": "xdg-open http://127.0.0.1:55323",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --db-url postgresql://postgres:postgres@127.0.0.1:55322/postgres > src/lib/supabase/database.types.ts",
    "test:filtros": "node --experimental-strip-types scripts/filtros.test.mjs",
    "test:caja": "node --experimental-strip-types scripts/caja.test.mjs",
    "test:horas": "node --experimental-strip-types scripts/horas.test.mjs",
    "test:credito": "docker exec -i supabase_db_zacgym-management-system psql -U postgres -q -v ON_ERROR_STOP=1 -f - < supabase/tests/saldo_a_favor.sql",
    "test:devolucion": "docker exec -i supabase_db_zacgym-management-system psql -U postgres -q -v ON_ERROR_STOP=1 -f - < supabase/tests/devolucion.sql",
    "test:rutina": "docker exec -i supabase_db_zacgym-management-system psql -U postgres -q -v ON_ERROR_STOP=1 -f - < supabase/tests/rutina_esperada.sql",
    "smoke:auth": "node --env-file=.env.local scripts/smoke-auth.mjs",
    "mail": "xdg-open http://127.0.0.1:55324",
    "test:ingresos": "node --experimental-strip-types scripts/ingresos.test.mjs",
    "test:nombres": "node --experimental-strip-types scripts/nombres.test.mjs",
    "test:mensualidades": "node --experimental-strip-types scripts/mensualidades.test.mjs",
    "test:pipelines": "node --experimental-strip-types scripts/pipelines.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^58.9.0"
  },
  "packageManager": "pnpm@11.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
