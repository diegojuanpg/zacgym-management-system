# =============================================================================
# ZacGym — credenciales. Copiar a `.env` y completar.
# `.env` esta en .gitignore. NUNCA commitear valores reales.
#
# Para que las MCP tools (github, supabase) tomen estos valores:
#   set -a; source .env; set +a; claude
# =============================================================================

# --- GitHub -------------------------------------------------------------------
# PAT fine-grained con permisos: Contents RW, Pull requests RW, Actions R,
# Metadata R sobre el repo del proyecto. https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Vercel -------------------------------------------------------------------
# Token de https://vercel.com/account/tokens (scope: la team/cuenta del proyecto)
VERCEL_TOKEN=
# Opcionales — los escribe `vercel link` en .vercel/project.json
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Supabase (cloud / produccion) --------------------------------------------
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Ref del proyecto cloud (la parte <ref> de https://<ref>.supabase.co)
SUPABASE_PROJECT_REF=
# Password del rol postgres del proyecto cloud (para `supabase db push`)
SUPABASE_DB_PASSWORD=
