# ==============================================================================
# ZacGym — variables de entorno. Copiar a `.env` y completar.
# `.env` y `.env.local` estan en .gitignore. NUNCA commitear valores reales.
# ==============================================================================

# --- LO QUE NECESITA LA APP ---------------------------------------------------
# Las unicas dos que hay que cargar en Vercel (Production, Preview y Development).
# Son publicas por diseno: viajan al browser. Van en `.env.local` para desarrollo.
# En local apuntan al stack de `supabase start` (puertos 553xx, ver README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SOLO PARA HERRAMIENTAS LOCALES -------------------------------------------
# NADA DE ESTO VA EN VERCEL. Son credenciales de las CLI que corren en tu maquina;
# el codigo de la app no lee ninguna. Van en `.env`, no en `.env.local`.
#
# Para que las tomen las MCP tools y los CLI:
#   set -a; source .env; set +a; claude

# PAT de GitHub: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Token de Vercel: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Los escribe `vercel link` en .vercel/project.json
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Ref del proyecto cloud (la parte <ref> de https://<ref>.supabase.co)
SUPABASE_PROJECT_REF=
# Password del rol postgres del proyecto cloud, para `supabase db push`
SUPABASE_DB_PASSWORD=
